<!-- app/views/password_settings/edit.html.erb -->
<!-- 設定（パスワード変更）画面 -->

<!-- 【修正】エラーメッセージをここに表示 -->
<!-- shared/error_messages パーシャルを使用してバリデーションエラーを表示 -->
<!-- object: @user で、@user のエラーメッセージを表示 -->
<%= render 'shared/error_messages', object: @user %>

<!-- 【修正】メイン画面:画面全体を中央揃えにして、上部に余白を追加 -->
<!-- items-start: 縦方向の上揃え -->
<!-- pt-6 sm:pt-8: レスポンシブ対応の上部余白 -->
<!-- px-4 sm:px-6: レスポンシブ対応の左右余白 -->
<main class="flex justify-center items-start min-h-screen bg-ivory pt-6 sm:pt-8 px-4 sm:px-6">
  <!-- 【修正】カードの背景色と余白の設定 -->
  <!-- bg-pure-white: 背景色を白に設定 -->
  <!-- p-5 sm:p-7 md:p-8: 余白を設定（レスポンシブ対応） -->
  <!-- max-w-2xl w-full: 最大幅を2xlに設定し、幅を100%に設定 -->
  <!-- rounded-2xl shadow-lg: 角を丸くし、影を付ける -->
  <div class="bg-pure-white p-5 sm:p-7 md:p-8 max-w-2xl w-full rounded-2xl shadow-lg">
    <!-- 【修正】タイトル -->
    <!-- text-xl sm:text-2xl md:text-3xl font-bold: テキストサイズを調整（レスポンシブ対応）、太字に設定 -->
    <!-- text-center: テキストを中央揃え -->
    <!-- text-brand-navy: テキスト色をブランドネイビーに設定 -->
    <!-- mb-6 sm:mb-8: 下の余白を設定（レスポンシブ対応） -->
    <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-center text-brand-navy mb-6 sm:mb-8">
      設定（パスワード変更）
    </h1>

    <!-- 【修正】パスワード変更フォーム -->
    <!-- form_with model: @user, url: password_setting_path: @user のデータを送信するフォームを作成 -->
    <!-- url: password_setting_path: パスワード変更のパスを指定（PATCH /password_setting） -->
    <!-- method: :patch: HTTPメソッドをPATCHに設定 -->
    <!-- local: true: Turboを無効化し、通常のHTTPリクエストを送信 -->
    <%= form_with model: @user, url: password_setting_path, method: :patch, local: true do |f| %>
      
      <!-- 【修正】現在のパスワード入力欄 -->
      <!-- mb-5 sm:mb-6: 下の余白を設定（レスポンシブ対応） -->
      <!-- relative: 相対位置を設定（アイコンを配置するため） -->
      <div class="mb-5 sm:mb-6 relative">
        <!-- 【修正】ラベル -->
        <!-- for属性を追加してアクセシビリティを向上 -->
        <!-- block mb-2: ブロック要素、下の余白を設定 -->
        <!-- text-brand-navy font-bold: テキスト色をブランドネイビー、太字に設定 -->
        <!-- text-base sm:text-lg: テキストサイズを設定（レスポンシブ対応） -->
        <%= f.label :current_password, "現在のパスワード", for: "current-password-field", class: "block mb-2 text-brand-navy font-bold text-base sm:text-lg" %>
        
        <!-- 【修正】入力欄のラッパー(アイコンと入力欄を囲む) -->
        <!-- relative: 相対位置を設定 -->
        <div class="relative">
          <!-- 【修正】SVG形式の鍵アイコン(位置、サイズを調整、色を統一) -->
          <!-- absolute left-3 sm:left-4: 絶対位置で左側に配置 -->
          <!-- top-1/2 -translate-y-1/2: 縦方向の中央に配置 -->
          <!-- w-5 h-5 sm:w-6 sm:h-6: サイズを設定（レスポンシブ対応） -->
          <!-- text-brand-navy: 色をブランドネイビーに設定 -->
          <!-- pointer-events-none: クリックイベントを無効化 -->
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-5 h-5 sm:w-6 sm:h-6 text-brand-navy pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- 鍵アイコンのパス -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>

          <!-- 【修正】パスワード入力欄 -->
          <!-- id: "current-password-field": IDを追加してJavaScriptから操作できるようにする -->
          <!-- autocomplete: "current-password": ブラウザの自動補完機能を有効化 -->
          <!-- w-full: 幅を100%に設定 -->
          <!-- py-4 sm:py-5: 上下の余白を設定（レスポンシブ対応） -->
          <!-- px-3 pl-11 sm:pl-12: 左右の余白を設定、左側はアイコン分の余白を確保 -->
          <!-- border border-brand-navy: 枠線をブランドネイビーに設定 -->
          <!-- rounded-xl: 角を丸くする -->
          <!-- text-base sm:text-lg: テキストサイズを設定（レスポンシブ対応） -->
          <!-- text-brand-navy: テキスト色をブランドネイビーに設定 -->
          <!-- bg-pure-white: 背景色を白に設定 -->
          <!-- transition-colors duration-300: 色の変化をアニメーション化 -->
          <!-- min-h-[55px] sm:min-h-[60px]: 最小の高さを設定（レスポンシブ対応） -->
          <!-- focus:outline-none focus:border-brand-orange: フォーカス時の枠線をオレンジに変更 -->
          <%= f.password_field :current_password, autocomplete: "current-password", id: "current-password-field", class: "w-full py-4 sm:py-5 px-3 pl-11 sm:pl-12 border border-brand-navy rounded-xl text-base sm:text-lg text-brand-navy bg-pure-white transition-colors duration-300 min-h-[55px] sm:min-h-[60px] focus:outline-none focus:border-brand-orange" %>
        </div>
      </div>

      <!-- 【修正】新しいパスワード入力欄 -->
      <!-- mb-5 sm:mb-6: 下の余白を設定（レスポンシブ対応） -->
      <!-- relative: 相対位置を設定（アイコンを配置するため） -->
      <div class="mb-5 sm:mb-6 relative">
        <!-- 【修正】ラベル -->
        <!-- for属性を追加してアクセシビリティを向上 -->
        <%= f.label :password, "新しいパスワード（8文字以上）", for: "new-password-field", class: "block mb-2 text-brand-navy font-bold text-base sm:text-lg" %>
        
        <!-- 【修正】入力欄のラッパー(アイコンと入力欄を囲む) -->
        <div class="relative">
          <!-- 【修正】SVG形式の鍵アイコン -->
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-5 h-5 sm:w-6 sm:h-6 text-brand-navy pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- 鍵アイコンのパス -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          
          <!-- 【修正】パスワード入力欄 -->
          <!-- id: "new-password-field": IDを追加してJavaScriptから操作できるようにする -->
          <%= f.password_field :password, autocomplete: "new-password", id: "new-password-field", class: "w-full py-4 sm:py-5 px-3 pl-11 sm:pl-12 border border-brand-navy rounded-xl text-base sm:text-lg text-brand-navy bg-pure-white transition-colors duration-300 min-h-[55px] sm:min-h-[60px] focus:outline-none focus:border-brand-orange" %>
        </div>
      </div>

      <!-- 【修正】新しいパスワード（確認）入力欄 -->
      <!-- mb-5 sm:mb-6: 下の余白を設定（レスポンシブ対応） -->
      <div class="mb-5 sm:mb-6 relative">
        <!-- 【修正】ラベル -->
        <%= f.label :password_confirmation, "新しいパスワード（確認）", for: "new-password-confirmation-field", class: "block mb-2 text-brand-navy font-bold text-base sm:text-lg" %>
        
        <!-- 【修正】入力欄のラッパー(アイコンと入力欄を囲む) -->
        <div class="relative">
          <!-- 【修正】SVG形式の鍵アイコン -->
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 w-5 h-5 sm:w-6 sm:h-6 text-brand-navy pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <!-- 鍵アイコンのパス -->
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          
          <!-- 【修正】パスワード入力欄 -->
          <!-- id: "new-password-confirmation-field": IDを追加してJavaScriptから操作できるようにする -->
          <%= f.password_field :password_confirmation, autocomplete: "new-password", id: "new-password-confirmation-field", class: "w-full py-4 sm:py-5 px-3 pl-11 sm:pl-12 border border-brand-navy rounded-xl text-base sm:text-lg text-brand-navy bg-pure-white transition-colors duration-300 min-h-[55px] sm:min-h-[60px] focus:outline-none focus:border-brand-orange" %>
        </div>
      </div>
      
      <!-- 【修正】パスワード表示チェックボックス -->
      <!-- mb-4 sm:mb-5: 下の余白を設定（レスポンシブ対応） -->
      <!-- flex items-center: フレックスボックス、縦方向の中央揃え -->
      <div class="mb-4 sm:mb-5 flex items-center">
        <!-- 【修正】チェックボックス -->
        <!-- id: "show-password": IDを追加してJavaScriptから操作できるようにする -->
        <!-- mr-2: 右の余白を設定 -->
        <!-- w-[18px] h-[18px] sm:w-5 sm:h-5: 幅と高さを設定（レスポンシブ対応） -->
        <!-- cursor-pointer: カーソルをポインターに変更 -->
        <input type="checkbox" id="show-password" class="mr-2 w-[18px] h-[18px] sm:w-5 sm:h-5 cursor-pointer">
        
        <!-- 【修正】チェックボックスのラベル -->
        <!-- for: "show-password": チェックボックスと紐付け -->
        <!-- text-brand-navy: テキスト色をブランドネイビーに設定 -->
        <!-- text-sm sm:text-base: テキストサイズを設定（レスポンシブ対応） -->
        <!-- cursor-pointer: カーソルをポインターに変更 -->
        <label for="show-password" class="text-brand-navy text-sm sm:text-base cursor-pointer">パスワードを表示する</label>
      </div>

      <!-- 【修正】登録ボタン -->
      <!-- mt-6 sm:mt-8: 上の余白を設定（レスポンシブ対応） -->
      <!-- text-center: テキストを中央揃え -->
      <div class="mt-6 sm:mt-8 text-center">
        <!-- 【修正】登録ボタン -->
        <!-- w-full: 幅を100%に設定 -->
        <!-- py-4 sm:py-5: 上下の余白を設定（レスポンシブ対応） -->
        <!-- bg-brand-orange: 背景色をオレンジに設定 -->
        <!-- text-pure-white: テキスト色を白に設定 -->
        <!-- border-none: 枠線を削除 -->
        <!-- rounded-xl: 角を丸くする -->
        <!-- text-lg sm:text-xl: テキストサイズを設定（レスポンシブ対応） -->
        <!-- font-bold: 太字に設定 -->
        <!-- cursor-pointer: カーソルをポインターに変更 -->
        <!-- transition-colors duration-300: 色の変化をアニメーション化 -->
        <!-- hover:bg-[#F27405]: ホバー時の背景色を設定 -->
        <!-- shadow-lg: 影を付ける -->
        <%= f.submit "変更", class: "w-full py-4 sm:py-5 bg-brand-orange text-pure-white border-none rounded-xl text-lg sm:text-xl font-bold cursor-pointer transition-colors duration-300 hover:bg-[#F27405] shadow-lg" %>
      </div>
    <% end %>
  </div>
</div>