<%# app/views/water_intakes/_water_intake.html.erb %>
<%# 飲水記録の1行分を表示するパーシャル %>

<%# 記録の行(下部に区切り線) %>
<tr id="water-intake-<%= water_intake.id %>" class="border-b border-gray-300">
  <%# 時刻列(中央揃え、太字) %>
  <td class="px-1 sm:px-2 py-2 text-center text-sm sm:text-base text-charcoal font-bold" style="font-family: 'Noto Sans JP', sans-serif;">
    <%# 時刻を「HH:MM」形式で表示 %>
    <%= water_intake.recorded_at.strftime('%H:%M') %>
  </td>
  <%# 飲水量列(中央揃え、太字) %>
  <td class="px-1 sm:px-2 py-2 text-center text-sm sm:text-base text-charcoal font-bold" style="font-family: 'Noto Sans JP', sans-serif;">
    <%# 飲水量を「○ml」形式で表示 %>
    <%= water_intake.amount_ml %>ml
  </td>
  <%# 【修正】削除ボタン列(中央揃え) %>
  <td class="px-1 py-2 text-center">
    <%# 【修正】削除ボタン(最小幅を44px以上に設定し、タップしやすくする) %>
    <%= button_to water_intake_path(water_intake),
        method: :delete,
        data: { turbo_confirm: 'この記録を削除しますか?削除すると元に戻せません。' },
        class: 'inline-flex items-center justify-center gap-1 bg-red-500 text-pure-white px-2 py-2 rounded-lg hover:bg-red-600 transition-colors font-bold text-xs sm:text-sm',
        style: "font-family: 'Noto Sans JP', sans-serif; min-height: 44px; min-width: 70px;" do %>
      <%# ゴミ箱アイコン %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      <%# 「削除」テキスト %>
      削除
    <% end %>
  </td>
</tr>
