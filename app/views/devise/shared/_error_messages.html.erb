<%# app/views/devise/shared/_error_messages.html.erb %>
<%# Devise用のエラーメッセージ %>

<%# resource にエラーが存在する場合のみ表示 %>
<% if resource.errors.any? %>
  <%# 【修正】エラーメッセージ表示エリア（背景色・枠線色をピンク系に変更） %>
  <%# ヘッダーの高さ分（64px）だけ下にずらす %>
  <div id="error_explanation" data-turbo-temporary class="fixed left-0 right-0 z-50 bg-red-50 border-2 border-red-400 text-red-700 px-6 py-4 rounded-lg mb-4 mx-4 shadow-lg" style="top: 64px;" role="alert" aria-live="assertive">
    <%# エラーメッセージのタイトル部分(文字サイズを1段階大きく) %>
    <h2 class="text-2xl sm:text-2xl font-bold text-red-700 mb-3">
      <%= I18n.t("errors.messages.not_saved",
                 count: resource.errors.count,
                 resource: resource.class.model_name.human.downcase)
       %>
    </h2>
    <%# エラーメッセージの一覧(文字サイズを1段階大きく) %>
    <ul class="list-disc list-inside text-lg sm:text-xl text-red-700 space-y-2 leading-relaxed">
      <%# 各エラーメッセージを表示 %>
      <% resource.errors.full_messages.each do |message| %>
        <%# 1件ずつエラーメッセージを表示 %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
