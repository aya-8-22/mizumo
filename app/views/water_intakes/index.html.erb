<%# app/views/water_intakes/index.html.erb %>
<%# 記録画面 %>

<%# 画面全体をアイボリー色の背景で表示、画面全体の高さを確保、中央配置 %>
<div class="bg-ivory min-h-screen flex items-center justify-center px-4 sm:px-6 py-6 sm:py-8">

  <%# 中央に白いカードを配置、最大幅を設定、影を追加して立体感を出す %>
  <div class="bg-pure-white p-5 sm:p-7 md:p-8 max-w-2xl w-full rounded-2xl shadow-lg">

    <%# タイトルと日付を一列に配置(横並び、中央揃え) %>
    <div class="flex items-center justify-between mb-6 sm:mb-7 md:mb-8">
      <%# 「記録」を左寄せで表示 %>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-brand-navy" style="font-family: 'Noto Sans JP', sans-serif;">
        記録
      </h1>
      <%# 日付を中央に配置 %>
      <p class="flex-1 text-lg sm:text-2xl md:text-3xl font-semibold text-brand-navy text-center" style="font-family: 'Noto Sans JP', sans-serif;">
        <%# 日本語の曜日を取得 %>
        <% wday_ja = %w[日 月 火 水 木 金 土][@today.wday] %>
        <%# 「8月2日(日)」形式で表示 %>
        <%= @today.strftime("%-m月%-d日(#{wday_ja})") %>
      </p>
      <%# 右側のスペース確保(左右対称にするため) %>
      <div class="text-2xl sm:text-3xl md:text-4xl invisible">記録</div>
    </div>

    <%# 目標水分摂取量のセクション %>
    <div class="mb-5 sm:mb-6 p-4 sm:p-5 rounded-xl shadow-md bg-ivory">
      <%# 見出しと区切り線を表示 %>
      <div class="mb-5 sm:mb-6 flex items-center">
        <%# 左側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
        <%# 見出し「目標水分摂取量」 %>
        <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-brand-navy px-3 sm:px-5" style="font-family: 'Noto Sans JP', sans-serif;">
          <%# 体重が設定されているかをチェック %>
          <% if current_user.weight.present? && current_user.weight > 0 %>
            <%# 体重が設定されている場合は目標水分摂取量を表示 %>
            目標量【<span id="daily-goal"><%= current_user.calculate_target_water_intake %></span>ml/日】
          <% else %>
            <%# 体重が未設定の場合はメッセージを表示 %>
            目標水分摂取量
          <% end %>
        </h2>
        <%# 右側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
      </div>

      <%# 体重が設定されている場合のみ進捗バーを表示 %>
      <% if current_user.weight.present? && current_user.weight > 0 %>
        <%# 進捗バーの外枠 %>
        <div class="w-full bg-gray-200 rounded-full h-5 sm:h-6 mb-3 relative">
          <%# 進捗率を計算(0%〜100%) %>
          <% progress_percentage = @daily_goal > 0 ? [(@today_total.to_f / @daily_goal * 100).round, 100].min : 0 %>
          <%# 進捗バーの内側(幅は進捗率に応じて変化) %>
          <div
            id="progress-bar"
            class="bg-brand-navy h-5 sm:h-6 rounded-full transition-all duration-300"
            style="width: <%= progress_percentage %>%"
          ></div>
          <%# 進捗率を中央に表示 %>
          <div class="absolute inset-0 flex items-center justify-center">
            <span id="progress-percentage" class="text-pure-white font-bold text-sm sm:text-base" style="font-family: 'Noto Sans JP', sans-serif; text-shadow: -1px -1px 0 #333, 1px -1px 0 #333, -1px 1px 0 #333, 1px 1px 0 #333;">
              <%= progress_percentage %>%
            </span>
          </div>
        </div>

        <%# 合計飲水量を右寄せで表示 %>
        <div class="text-right">
          <span class="text-base sm:text-lg md:text-xl text-charcoal font-semibold" style="font-family: 'Noto Sans JP', sans-serif;">
            合計飲水量:
            <span id="today-total" class="font-bold"><%= @today_total %></span>ml
          </span>
        </div>

      <% else %>
        <%# 体重が未設定の場合のメッセージを表示 %>
        <div class="text-center py-4">
          <p class="text-base sm:text-lg font-bold text-charcoal" style="font-family: 'Noto Sans JP', sans-serif;">
            体重を設定すると目標水分摂取量が表示されます
          </p>
          <%# 設定画面へのリンクを表示 %>
          <div class="mt-4">
            <%= link_to '設定(体重)画面へ',
                edit_weight_setting_path,
                class: 'inline-block px-6 py-3 bg-brand-orange text-pure-white rounded-lg hover:opacity-90 transition-colors font-bold text-base sm:text-lg',
                style: "font-family: 'Noto Sans JP', sans-serif;" %>
          </div>
        </div>
      <% end %>

    </div>

    <%# 飲水記録のセクション %>
    <div class="mb-5 sm:mb-6 p-4 sm:p-5 rounded-xl shadow-md bg-ivory">
      <%# 【修正】見出しと区切り線を表示 %>
      <div class="mb-5 sm:mb-6 flex items-center">
        <%# 左側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
        <%# 見出し「飲水記録」 %>
        <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-brand-navy px-3 sm:px-5" style="font-family: 'Noto Sans JP', sans-serif;">
          飲水記録
        </h2>
        <%# 右側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
      </div>

      <%# フォームを作成(Ajaxで送信) %>
      <%= form_with url: water_intakes_path, method: :post, local: false, id: 'water-intake-form' do |f| %>

        <%# 飲水時間設定 %>
        <div class="mb-6">
          <%# ラベル「①飲水時間(時間は変更可)」 %>
          <%= label_tag :recorded_at, '①飲水時間(時間は変更可)', class: 'block text-base sm:text-lg md:text-xl font-semibold text-charcoal mb-2 text-center', style: "font-family: 'Noto Sans JP', sans-serif;" %>
          <%# 時刻入力フィールド %>
          <%= time_field_tag :recorded_at,
              Time.zone.now.strftime('%H:%M'),
              id: 'recorded-at-field',
              class: 'w-full px-2 sm:px-3 md:px-4 py-4 sm:py-5 md:py-6 border-2 border-brand-navy rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-navy text-xl sm:text-2xl md:text-3xl font-bold text-center',
              style: "font-family: 'Noto Sans JP', sans-serif;" %>
        </div>

        <%# 水分摂取量のボタン %>
        <div class="mb-4">
          <%# ラベル「②飲水量(下記ボタンで記録)」 %>
          <label class="block text-base sm:text-lg md:text-xl font-semibold text-charcoal mb-2 text-center" style="font-family: 'Noto Sans JP', sans-serif;">②飲水量(下記ボタンで記録)</label>
          <%# ボタンを横3列に配置 %>
          <div class="grid grid-cols-3 gap-3 sm:gap-4">
            <%# 150mlボタン %>
            <button type="button"
                    class="amount-btn w-full px-3 sm:px-4 py-5 sm:py-6 bg-brand-orange text-pure-white rounded-lg hover:opacity-90 transition-colors font-bold text-lg sm:text-xl"
                    data-amount="150"
                    style="font-family: 'Noto Sans JP', sans-serif; min-height: 44px; min-width: 44px;">
              150ml
            </button>
            <%# 200mlボタン %>
            <button type="button"
                    class="amount-btn w-full px-3 sm:px-4 py-5 sm:py-6 bg-brand-orange text-pure-white rounded-lg hover:opacity-90 transition-colors font-bold text-lg sm:text-xl"
                    data-amount="200"
                    style="font-family: 'Noto Sans JP', sans-serif; min-height: 44px; min-width: 44px;">
              200ml
            </button>
            <%# 250mlボタン %>
            <button type="button"
                    class="amount-btn w-full px-3 sm:px-4 py-5 sm:py-6 bg-brand-orange text-pure-white rounded-lg hover:opacity-90 transition-colors font-bold text-lg sm:text-xl"
                    data-amount="250"
                    style="font-family: 'Noto Sans JP', sans-serif; min-height: 44px; min-width: 44px;">
              250ml
            </button>
          </div>

          <%# 【追加】補足テキスト「＊補足:コップ1杯は200ml」 %>
          <p class="text-sm sm:text-base text-charcoal text-center mt-3 font-bold" style="font-family: 'Noto Sans JP', sans-serif;">
            ＊目安量：コップ1杯 = 200ml
          </p>

          <%# 隠しフィールド(JavaScriptで値を設定) %>
          <%= hidden_field_tag :amount_ml, nil, id: 'amount-ml-input' %>
        </div>
      <% end %>
    </div>

    <%# 飲水履歴のセクション %>
    <div class="mb-5 sm:mb-6 p-4 sm:p-5 rounded-xl shadow-md bg-ivory">
      <%# 【修正】見出しと区切り線を表示 %>
      <div class="mb-5 sm:mb-6 flex items-center">
        <%# 左側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
        <%# 見出し「飲水履歴」 %>
        <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-brand-navy px-3 sm:px-5" style="font-family: 'Noto Sans JP', sans-serif;">
          飲水履歴
        </h2>
        <%# 右側の区切り線 %>
        <div class="flex-1 border-t-2 border-brand-navy"></div>
      </div>

      <%# 飲水履歴一覧を表示 %>
      <div id="water-intakes-list">
        <%# 横スクロール可能にする %>
        <div class="overflow-x-auto">
          <%# テーブル(幅100%、列幅を固定) %>
          <table class="w-full table-fixed">
            <%# テーブルヘッダー %>
            <thead>
              <%# ヘッダー行(下部に太い区切り線) %>
              <tr class="border-b-2 border-brand-navy">
                <%# 「時間」列のヘッダー(幅を33%に設定) %>
                <th class="px-2 sm:px-4 py-2 text-center text-base sm:text-lg font-semibold text-charcoal w-1/3" style="font-family: 'Noto Sans JP', sans-serif;">時間</th>
                <%# 「飲水量」列のヘッダー(幅を33%に設定) %>
                <th class="px-2 sm:px-4 py-2 text-center text-base sm:text-lg font-semibold text-charcoal w-1/3" style="font-family: 'Noto Sans JP', sans-serif;">飲水量</th>
                <%# 「削除」列のヘッダー(幅を33%に設定) %>
                <th class="px-2 sm:px-4 py-2 text-center text-base sm:text-lg font-semibold text-charcoal w-1/3" style="font-family: 'Noto Sans JP', sans-serif;">削除</th>
              </tr>
            </thead>
            <%# テーブルボディ(Turbo Streamで更新される部分) %>
            <tbody id="water-intakes-tbody">
              <%# 記録が空の場合 %>
              <% if @water_intakes.empty? %>
                <%# 「本日の記録はありません」を表示 %>
                <tr id="no-records-message">
                  <%# 3列分を結合 %>
                  <td colspan="3" class="text-charcoal text-center py-4 text-base sm:text-lg font-bold" style="font-family: 'Noto Sans JP', sans-serif;">
                    本日の記録はありません
                  </td>
                </tr>
              <% else %>
                <%# パーシャルを使って各飲水記録を表示 %>
                <%= render @water_intakes %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# 注意アイコンと注意事項を表示 %>
    <div class="flex items-start">
      <%# 注意アイコン(オレンジ色) %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 text-brand-orange mr-2 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <%# 注意事項のテキスト %>
      <div>
        <p class="text-sm sm:text-base text-charcoal leading-relaxed ">
          ・【削除ボタン】削除すると復元不可です<br>
          ・【追加記録】時間変更で、記載可能です<br>
          ・【目標達成状況】カレンダー画面から確認可能です<br>
          ・【疾患・飲水制限・体調変化がある場合】医師に相談してください
        </p>
      </div>
    </div>

  </div>
</div>

