<%# app/views/shared/_error_messages.html.erb %>
<%# 通常のエラーメッセージを表示するための共通パーシャル %>

<%# object が nil でない、かつエラーが存在する場合のみ表示 %>
<% if object.present? && object.errors.any? %>
  <%# 【修正】固定表示用のコンテナを追加（画面上部に固定、z-indexで最前面に表示） %>
  <%# ヘッダーの高さ分（64px）だけ下にずらす %>
  <div id="error_explanation" class="fixed left-0 right-0 z-50 bg-red-50 border-2 border-red-400 text-red-700 px-6 py-4 rounded-lg mb-4 mx-4 shadow-lg" style="top: 64px;" role="alert" aria-live="assertive">
    <%# エラー件数の表示（文字サイズを1段階大きく） %>
    <h2 class="text-2xl sm:text-2xl font-bold text-red-700 mb-3">
      <%= object.errors.count %>個のエラーがあります
    </h2>
    <%# エラーメッセージの一覧（文字サイズを1段階大きく、space-y-2、leading-relaxedを追加） %>
    <ul class="mb-0 list-disc list-inside text-lg sm:text-xl text-red-700 space-y-2 leading-relaxed">
      <%# 各エラーメッセージを表示 %>
      <% object.errors.each do |error| %>
        <%# 1件ずつエラーメッセージを表示 %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>