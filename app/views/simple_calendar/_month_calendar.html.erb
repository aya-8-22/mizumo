<%# app/views/simple_calendar/_month_calendar.html.erb %>
<%# カレンダーのテンプレート（カスタマイズ版） %>

<%# カレンダー全体のコンテナ %>
<div class="simple-calendar">
  <%# カレンダーのヘッダー部分: 設定画面と同じスタイルに統一 %>
  <%# 【修正】mb-1で下余白を最小限に %>
  <div class="calendar-heading flex justify-between items-center mb-1 sm:mb-8">
    <%# 前月へのリンク %>
    <%# 【修正】text-baseでスマホ時の文字サイズを調整 %>
    <%= link_to calendar.url_for_previous_view, class: "text-brand-navy hover:opacity-90 transition font-bold text-base sm:text-xl" do %>
      ◀️前月
    <% end %>

    <%# 現在の年月を表示: ネイビー色に変更 %>
    <%# 【修正】text-lgでスマホ時の文字サイズを調整 %>
    <span class="calendar-title text-lg sm:text-2xl md:text-3xl font-bold text-brand-navy">
      <%= I18n.l(start_date, format: :year_month) %>
    </span>

    <%# 次月へのリンク %>
    <%# 【修正】text-baseでスマホ時の文字サイズを調整 %>
    <%= link_to calendar.url_for_next_view, class: "text-brand-navy hover:opacity-90 transition font-bold text-base sm:text-xl" do %>
      次月▶️
    <% end %>
  </div>

  <%# カレンダーのテーブル部分 %>
  <table class="simple-calendar-table w-full border-collapse">
    <%# 曜日のヘッダー行 %>
    <thead>
      <tr>
        <%# 各曜日を表示 %>
        <% date_range.slice(0, 7).each do |day| %>
          <%# 曜日のセル %>
          <%# 【修正】py-0.5で上下余白を最小限に、text-centerで中央表示 %>
          <th class="py-0.5 sm:py-3 text-center">
            <%# 曜日の文字を表示 %>
            <%# 【修正】text-smでスマホ時の文字サイズを調整 %>
            <span class="text-sm sm:text-base font-semibold text-brand-navy">
              <%= t('date.abbr_day_names')[day.wday] %>
            </span>
          </th>
        <% end %>
      </tr>
    </thead>

    <%# カレンダーの日付部分 %>
    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <%# 【修正】h-8でスマホ時の行の高さを最小限に %>
        <tr class="h-8 sm:h-auto">
          <% week.each do |day| %>
            <%# 各日付のセル %>
            <%# 【修正】h-11でセルの高さを小さく、py-0.5で上下余白を最小限に %>
            <%= content_tag :td, class: calendar.td_classes_for(day).join(' ') + " h-11 sm:h-20 border border-gray-300 py-0.5 sm:py-2" do %>
              <% if defined?(Haml) && respond_to?(:block_is_haml?) && block_is_haml?(passed_block) %>
                <% capture_haml(day, sorted_events.fetch(day, []), &passed_block) %>
              <% else %>
                <% passed_block.call day, sorted_events.fetch(day, []) %>
              <% end %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
