<!-- app/views/shared/_flash_message.html.erb -->
<!-- フラッシュメッセージを表示するパーシャルファイル -->

<!-- フラッシュメッセージがある場合のみ表示する -->
<% if flash.any? %>
  <!-- ヘッダー直下に配置、幅いっぱいに表示 -->
  <div class="w-full">
    <!-- flash の中身を1つずつ取り出すループ -->
    <% flash.each do |message_type, message| %>
      <!-- message_type に応じて色を変える条件分岐 -->
      <%
        # message_type が success または notice の場合は緑色
        if message_type.to_s == 'success' || message_type.to_s == 'notice'
          color_classes = "bg-green-100 border-green-400 text-green-700"
        # message_type が danger または alert の場合は赤色
        elsif message_type.to_s == 'danger' || message_type.to_s == 'alert'
          color_classes = "bg-red-100 border-red-400 text-red-700"
        # その他の場合は青色（お知らせ用）
        else
          color_classes = "bg-blue-100 border-blue-400 text-blue-700"
        end
      %>
      
      <!-- フラッシュメッセージを表示（色は条件分岐で決定） -->
      <div class="<%= color_classes %> border-2 px-4 py-3 rounded-lg mb-4 text-center mx-4 mt-4 !text-2xl sm:!text-2xl leading-relaxed font-bold" data-controller="flash" data-flash-target="message">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>

