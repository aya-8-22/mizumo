# .env.example
# プロジェクトに必要な環境変数の「見本（ひな形・テンプレート）」ファイル

# Resend API キー（本番環境用）
# 取得方法: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# データベース接続URL（本番環境用）
# Neonのダッシュボードから取得
DATABASE_URL=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxx 

# Redis接続URL（本番環境用）
REDIS_URL=redis://xxxxxxxxxxxxxxxxxxxxxxxxxx 