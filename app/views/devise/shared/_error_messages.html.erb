<%# app/views/devise/shared/_error_messages.html.erb %>
<%# Devise用のエラーメッセージ %>

<%# resource にエラーが存在する場合のみ表示 %>
<% if resource.errors.any? %>
   <!-- エラーメッセージ表示エリア -->
  <div id="error_explanation" data-turbo-temporary class="bg-red-50 border-2 border-red-400 text-red-700 px-4 sm:px-6 py-4 rounded-lg mb-6 shadow-lg max-h-[50vh] overflow-y-auto" role="alert" aria-live="assertive">
    <%# エラーメッセージのタイトル部分 %>
    <h2 class="text-2xl sm:text-2xl font-bold text-red-700 mb-3">
      <%= resource.errors.count %>個のエラーがあります
    </h2>
    <%# エラーメッセージの一覧(文字サイズを1段階大きく) %>
    <ul class="list-disc list-inside text-lg sm:text-xl text-red-700 space-y-2 leading-relaxed">
      <%# 各エラーメッセージを表示 %>
      <% resource.errors.full_messages.each do |message| %>
        <%# 1件ずつエラーメッセージを表示 %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
