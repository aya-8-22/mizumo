# .env.example
# プロジェクトに必要な環境変数の「見本（ひな形・テンプレート）」ファイル

# 【修正】Resend API キー（テスト用）
# 取得方法: https://resend.com/api-keys
# テスト用 API キーを使用する場合、独自ドメインは不要
# 注意：テスト用で記載しているので、本番用のドメイン取得後は変更が必要
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# データベース接続URL（本番環境用）
# Neon のダッシュボードから取得（Pooled connection を使用）
DATABASE_URL=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxx 

# Redis接続URL（本番環境用）
# Render の Redis ダッシュボードから取得
REDIS_URL=redis://xxxxxxxxxxxxxxxxxxxxxxxxxx 

# 【修正】Rails のマスターキー（本番環境用）
# config/master.key の内容をコピーして設定
# 暗号化されたデータの復号化に必要
RAILS_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 【修正】Rails 環境（本番環境用）
RAILS_ENV=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 【修正】アプリのホスト名（本番環境用）
# Render の Web Service のホスト名を設定
APP_HOST=mizumo-db-neon.onrender.com