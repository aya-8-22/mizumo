<%# app/views/shared/_error_messages.html.erb %>
<%# 通常のエラーメッセージを表示するための共通パーシャル %>

<%# 【修正】object が nil でない、かつエラーが存在する場合のみ表示 %>
<% if object.present? && object.errors.any? %>
  <%# エラーメッセージ表示エリア(背景色・枠線色をピンク系に変更) %>
  <div id="error_explanation" class="bg-red-50 border-2 border-red-400 text-red-700 px-6 py-4 rounded-lg relative mb-4">
    <%# 【修正】エラー件数の表示(文字サイズを1段階大きく) %>
    <h2 class="text-2xl sm:text-2xl font-bold text-red-700 mb-3">
      <%= object.errors.count %>個のエラーがあります
    </h2>
    <%# 【修正】エラーメッセージの一覧(文字サイズを1段階大きく、space-y-2、leading-relaxedを追加) %>
    <ul class="mb-0 list-disc list-inside text-lg sm:text-xl text-red-700 space-y-2 leading-relaxed">
      <%# 各エラーメッセージを表示 %>
      <% object.errors.each do |error| %>
        <%# 1件ずつエラーメッセージを表示 %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>