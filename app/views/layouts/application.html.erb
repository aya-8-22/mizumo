<%# app/views/layouts/application.html.erb %>
<%# Webサイト全体の共通テンプレート(ひな形) %>
<!DOCTYPE html>
<html>
  <head>
    <%# ページタイトルを動的に設定 %>
    <title><%= page_title(yield(:title)) %></title>
    <%# レスポンシブ対応のためのビューポート設定 %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# CSRF トークンを埋め込む(セキュリティ対策) %>
    <%= csrf_meta_tags %>
    <%# Content Security Policy を設定(セキュリティ対策) %>
    <%= csp_meta_tag %>
    <%# Tailwind CSS を読み込む %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%# アプリケーション固有の CSS を読み込む %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# JavaScript ファイルを読み込む %>
    <%= javascript_importmap_tags %>
  </head>

  <%# body タグに背景色とテキスト色を設定 %>
  <body class="bg-ivory text-charcoal">
    <%# 【修正】ヘッダーを条件付きで表示(初回モーダル時は非表示) %>
    <%# @first_time が定義されている場合は first_time: @first_time を渡す %>
    <%# @first_time が定義されていない場合は first_time: false がデフォルトで使われる %>
    <% if show_header?(first_time: @first_time) %>
      <%= render 'shared/header' %>
    <% end %>

    <%# メインコンテンツエリア(ボトムナビゲーションの有無で余白を変える) %>
    <%# 【修正】ボトムナビゲーションの表示判定に first_time: @first_time を渡す %>
    <%# @first_time が定義されている場合は first_time: @first_time を渡す %>
    <%# @first_time が定義されていない場合は first_time: false がデフォルトで使われる %>
    <main class="<%= show_bottom_navigation?(first_time: @first_time) ? 'pb-16' : 'pb-4' %>">
      <%# フラッシュメッセージをパーシャルで表示 %>
      <%= render 'shared/flash_message' %>

      <%= yield %>
    </main>

    <%# 【修正】ボトムナビゲーションを条件付きで表示 %>
    <%# @first_time が定義されている場合は first_time: @first_time を渡す %>
    <%# @first_time が定義されていない場合は first_time: false がデフォルトで使われる %>
    <% if show_bottom_navigation?(first_time: @first_time) %>
      <%= render 'shared/bottom_navigation' %>
    <% end %>

    <%# フッターをパーシャルで読み込む %>
    <%= render 'shared/footer' %>
  </body>
</html>
