<!-- 【仮追加】app/views/static_pages/contact.html.erb -->
<!-- 静的なページ：お問い合わせページの見た目（フォームや連絡先の案内） -->

<!-- 【追加】エラーメッセージをここに表示 -->
<%= render 'shared/error_messages', object: current_user %>

<!-- コンテナ全体のレイアウト設定 -->
<div class="container mx-auto px-4 py-8">
  <!-- ページタイトル -->
  <h1 class="text-2xl font-bold mb-4">お問い合わせ</h1>
  <!-- 準備中メッセージ -->
  <p>お問い合わせページです。(準備中)</p>
  <p>記載予定：使用方法やご意見、退会に関して、こちらからご連絡ください。</p>
  <p>問い合わせ内容により、回答まで時間がかかる場合や回答を控えさせて頂く場合がございます。</p>
</div>